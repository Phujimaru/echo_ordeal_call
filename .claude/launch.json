{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "client-valentine",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev"
      ],
      "port": 5173,
      "env": {
        "ECHO_SERVER_PORT": "3005"
      }
    },
    {
      "name": "plans",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180",
        "--bind",
        "127.0.0.1"
      ],
      "port": 5180
    },
    {
      "name": "server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 3000
    },
    {
      "name": "server-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 3000,
      "env": {
        "ECHO_DEV_START_ROUND": "26",
        "ECHO_DEV_ACTION_TIME": "600"
      }
    },
    {
      "name": "server-zero",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 3000,
      "env": {
        "ECHO_DEV_ZERO": "1",
        "ECHO_DEV_START_ROUND": "3",
        "ECHO_DEV_ACTION_TIME": "600",
        "JOURNEY_START_SECONDS": "0",
        "ECHO_DEV_ZERO_SEAL_HP": "1"
      }
    },
    {
      "name": "server-valentine",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 3005,
      "env": {
        "ECHO_DEV_START_ROUND": "3",
        "ECHO_DEV_ACTION_TIME": "600",
        "JOURNEY_START_SECONDS": "0",
        "ECHO_DEV_RICH": "1",
        "PORT": "3005"
      }
    },
    {
      "name": "server-diego",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 3000,
      "env": {
        "ECHO_DEV_START_ROUND": "3",
        "ECHO_DEV_ACTION_TIME": "600",
        "JOURNEY_START_SECONDS": "0",
        "ECHO_DEV_DIEGO_CUNNING": "10"
      }
    },
    {
      "name": "server-celine",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 3000,
      "env": {
        "ECHO_DEV_RICH": "1",
        "ECHO_DEV_ACTION_TIME": "600",
        "JOURNEY_START_SECONDS": "0"
      }
    },
    {
      "name": "server-takuto",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 3007,
      "env": {
        "PORT": "3007",
        "ECHO_DEV_ZERO": "1",
        "ECHO_DEV_ZERO_SEAL_HP": "1",
        "ECHO_DEV_RICH": "1",
        "ECHO_DEV_ACTION_TIME": "600",
        "JOURNEY_START_SECONDS": "0"
      }
    },
    {
      "name": "client-takuto",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev",
        "--",
        "--port",
        "5177",
        "--strictPort"
      ],
      "port": 5177,
      "env": {
        "ECHO_SERVER_PORT": "3007"
      }
    }
  ]
}